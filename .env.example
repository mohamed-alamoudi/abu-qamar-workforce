# ───────────── نظام إدارة موظفي سوبر ماركت أبو قمر ─────────────
# انسخ هذا الملف إلى .env واملأ القيم. لا تضع أسرارًا حقيقية في المستودع.

NODE_ENV=development

# ── قاعدة البيانات ──
DATABASE_URL=postgresql://abuqamar:CHANGE_ME@localhost:5432/abu_qamar_dev?schema=public
# قاعدة مستقلة لاختبارات التكامل (تُمسح بياناتها في كل تشغيل — لا تستخدم قاعدة حقيقية!)
DATABASE_URL_TEST=postgresql://abuqamar:CHANGE_ME@localhost:5433/abu_qamar_test?schema=public
# كلمة مرور حاوية PostgreSQL المحلية (docker compose)
POSTGRES_PASSWORD=CHANGE_ME

# ── الخادم ──
PORT=4000
# رابط الواجهة (Next.js) ورابط الخادم
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# النطاقات المسموح لها (مفصولة بفواصل). يجب أن تتضمن رابط الواجهة.
CORS_ORIGIN=http://localhost:3000
# عدد الوسطاء (proxies) الموثوقين أمام الخادم لاستخراج IP العميل الصحيح. 0 محليًا.
TRUST_PROXY=0

# ── الأسرار (ولّدها بـ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ──
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# ── الجلسات ──
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
REMEMBER_DEVICE_TTL_DAYS=30
REAUTH_WINDOW_MINUTES=5
COOKIE_SAMESITE=lax

# ── إعداد الأدمن الأول (يُستخدم مرة واحدة ثم يُحذف) ──
# رمز عشوائي لا يقل عن 32 حرفًا. في الإنتاج يجب تحديد وقت انتهاء له.
SETUP_TOKEN=
# مثال: 2026-12-01T12:00:00Z
SETUP_TOKEN_EXPIRES_AT=

# ── تحديد المعدل ──
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ── توثيق OpenAPI على /docs (مفعّل دائمًا خارج الإنتاج) ──
ENABLE_API_DOCS=false

# ── النسخ الاحتياطي (المرحلة السادسة) ──
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_REGION=
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=

# حساب أدمن موجود في قاعدة التطوير (لاختبارات E2E)
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
E2E_BASE_URL=
E2E_BACKUPS=0

# إعدادات إضافية لنسخ S3 المتوافق وتطوير Windows
BACKUP_STORAGE_DRIVER=
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_PREFIX=
BACKUP_STORAGE_FORCE_PATH_STYLE=
BACKUP_LOCAL_DIR=
PG_DUMP_COMMAND=
PG_RESTORE_COMMAND=
PG_TOOLS_HOST=
PG_TOOLS_PORT=

# مراقبة الأخطاء اختيارية
SENTRY_DSN=
